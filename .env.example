# Copy to .env and edit. Never commit .env.
NODE_ENV=production
PORT=3000
# The https address people use to reach the app. Used for the Google sign-in return address and the links shown in the app.
PUBLIC_URL=https://trueline.example.com
# Required in production. Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Encrypts stored Google tokens and webhook addresses. Keep it safe: if it is lost, users must reconnect Google.
ENCRYPTION_KEY=
# Who may create an account. Set ALLOW_SIGNUP=false after your team has signed up, or set an invite code.
ALLOW_SIGNUP=true
# SIGNUP_CODE=
# Google Calendar, Tasks and Docs (optional). See docs/GOOGLE.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# How often connected services are refreshed even with no new files (hours).
SYNC_HOURS=6
# Where accounts and files are stored. In Docker this is the mounted volume.
DATA_DIR=/data
MAX_UPLOAD_MB=10
LOG_LEVEL=info
# Set to false only if you serve the app over plain http inside a private network.
# COOKIE_SECURE=true
# Which proxies may tell Trueline the visitor's address (X-Forwarded-For), used for sign-in rate limits.
# Default: only proxies on this machine or a private network (Caddy/nginx on localhost, Docker, a cloud load balancer).
# Set a hop count (e.g. 1) or addresses only if your proxy connects from a public address.
# TRUST_PROXY=loopback, linklocal, uniquelocal
